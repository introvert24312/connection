{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Catalog Schema",
  "description": "Schema for validating service catalog YAML files",
  "type": "object",
  "required": ["name", "purpose", "owner", "health", "runbook"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Service identifier",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "purpose": {
      "type": "string",
      "description": "Brief description of service purpose",
      "minLength": 1,
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "description": "Team/person responsible + oncall info",
      "minLength": 1
    },
    "health": {
      "type": "string",
      "description": "Health check endpoint",
      "pattern": "^/.*"
    },
    "openapi": {
      "type": "string",
      "description": "Path to OpenAPI specification",
      "pattern": "\\.(yaml|yml)$"
    },
    "asyncapi": {
      "type": "string",
      "description": "Path to AsyncAPI specification", 
      "pattern": "\\.(yaml|yml)$"
    },
    "depends_on": {
      "type": "array",
      "description": "List of dependent services",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "uniqueItems": true
    },
    "runbook": {
      "type": "string",
      "description": "Path to troubleshooting guide",
      "pattern": "\\.(md|markdown)$"
    }
  },
  "additionalProperties": false
}