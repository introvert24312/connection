{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dependency Schema",
  "description": "Schema for validating fine-grained dependency YAML files",
  "type": "object",
  "required": ["from", "to"],
  "properties": {
    "from": {
      "type": "string",
      "description": "Source endpoint in format: service METHOD /path",
      "pattern": "^[a-z][a-z0-9-]* (GET|POST|PUT|DELETE|PATCH) /.*"
    },
    "to": {
      "oneOf": [
        {
          "type": "string",
          "description": "Target endpoint in format: service METHOD /path",
          "pattern": "^[a-z][a-z0-9-]* (GET|POST|PUT|DELETE|PATCH) /.*"
        },
        {
          "type": "object",
          "description": "Detailed target specification",
          "required": ["endpoint"],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]* (GET|POST|PUT|DELETE|PATCH) /.*"
            },
            "contract": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Required fields"
                },
                "errors": {
                  "type": "array", 
                  "items": {"type": "integer"},
                  "description": "Expected error codes"
                },
                "auth": {
                  "type": "string",
                  "enum": ["bearer", "basic", "apikey", "none"],
                  "description": "Authentication method"
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Timeout in milliseconds"
                }
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}